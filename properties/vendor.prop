# Audio
persist.vendor.audio.misound.disable=true
ro.audio.monitorRotation=true
ro.vendor.audio.btsamplerate.adaptive=true
ro.vendor.audio.dualadc.support=true
ro.vendor.audio.gain.support=true
ro.vendor.audio.support.sound.id=true

# AVF
avf.remote_attestation.enabled=false

# Bluetooth
bluetooth.profile.asha.central.enabled=true
bluetooth.profile.bap.broadcast.assist.enabled=true
bluetooth.profile.bap.broadcast.source.enabled=true
bluetooth.profile.bap.unicast.client.enabled=true
bluetooth.profile.ccp.server.enabled=true
bluetooth.profile.csip.set_coordinator.enabled=true
bluetooth.profile.hap.client.enabled=true
bluetooth.profile.mcp.server.enabled=true
bluetooth.profile.vcp.controller.enabled=true
persist.bluetooth.leaudio_offload.disabled=false
persist.sys.fflag.override.settings_bluetooth_hearing_aid=false
persist.vendor.qcom.bluetooth.aptxadaptiver2_1_support=true
persist.vendor.qti.btadvaudio.target.support.xpan=true

# Camera
ro.camera.enableCamera1MaxZsl=1
ro.camerax.extensions.enabled=true

# Crypto
ro.crypto.metadata_init_delete_all_keys.enabled=true
vendor.wv.oemcrypto.debug.enable_external_display_check=false
vendor.wv.oemcrypto.debug.enable_hlos_data_path=true

# Device
ro.product.marketname=POCO F7
ro.product.mod_device=onyx_global

# Displayfeature
ro.vendor.displayfeature.dump=true

# Dex2oat
dalvik.vm.dex2oat64.enabled=true
dalvik.vm.dex2oat-cpu-set=4,5,6,7
dalvik.vm.dex2oat-threads=4
dalvik.vm.image-dex2oat-cpu-set=4,5,6,7
dalvik.vm.image-dex2oat-threads=4

# DPM
persist.vendor.dpm.vndr.feature=1
persist.vendor.dpm.vndr.idletimer.mode=default

# DRM
drm.service.enabled=true

# fingerprint
persist.vendor.fingerprint.type=udfps_optical
persist.vendor.fingerprint.sensor_location=640|2518|105

# FUSE
persist.sys.fuse.passthrough.enable=true

# Gatekeeper
vendor.gatekeeper.disable_spu=true
vendor.gatekeeper.is_security_level_spu=0

# Graphics
debug.sf.enable_transaction_tracing=false
debug.sf.region_sampling_period_ns=200000000
debug.sf.region_sampling_timer_timeout_ns=200000000
graphics.gpu.profiler.support=true
ro.gfx.driver.1=com.qualcomm.qti.gpudrivers.sun.api35
ro.hardware.egl=adreno
ro.hardware.vulkan=adreno
ro.opengles.version=196610
vendor.display.disable_system_load_check=1

# Incremental FS
ro.incremental.enable=yes

# Keymint
vendor.keymint.retry_timer=5

# Keystore
ro.hardware.keystore_desede=true

# Media
debug.stagefright.c2inputsurface=-1
media.c2.hal.selection=aidl
ro.mediaserver.64b.enable=true
vendor.media.omx=0

# Media (steps)
ro.config.alarm_vol_steps=15
ro.config.media_vol_default=10
ro.config.system_vol_steps=15
ro.config.vc_call_vol_steps=11

# QSYSD
persist.vendor.qcomsysd.enabled=1

# RIL
persist.radio.multisim.config=dsds
persist.vendor.radio.apm_sim_not_pwdn=1
persist.vendor.radio.custom_ecc=1
persist.vendor.radio.enableadvancedscan=true
persist.vendor.radio.procedure_bytes=SKIP
persist.vendor.radio.sib16_support=1
persist.vendor.rcs.singlereg.feature=1
ro.vendor.radio.build_profile=miui
ro.vendor.radio.build_region=global

# Sensors
ro.vendor.sensors.xiaomi.double_tap=true
ro.vendor.sensors.xiaomi.single_tap=true
ro.vendor.sensors.xiaomi.udfps=true

# Shutdown
sys.vendor.shutdown.waittime=500

# SSR
ro.vendor.vm.ssr.enable=false

# USB
ro.recovery.usb.adb.pid=D001
ro.recovery.usb.fastboot.pid=4EE0
ro.recovery.usb.vid=18D1
ro.usb.uvc.enabled=true
sys.usb.mtp.batchcancel=1
vendor.usb.controller=a600000.dwc3
vendor.usb.diag.func.name=ffs
vendor.usb.dpl.inst.name=dpl
vendor.usb.qdss.inst.name=qdss_sw
vendor.usb.rmnet.func.name=gsi
vendor.usb.rmnet.inst.name=rmnet
vendor.usb.rndis.func.name=gsi
vendor.usb.use_ffs_mtp=1
vendor.usb.use_gadget_hal=1

# WiFi
wifi.aware.interface=wifi-aware0
