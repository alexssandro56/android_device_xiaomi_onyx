From 6a8f1d7ac6281258c69a6670c5f578a2b8eaad88 Mon Sep 17 00:00:00 2001
From: alexssandro56 <05jeelo30@gmail.com>
Date: Thu, 22 Oct 2026 18:52:36 +0000
Subject: [PATCH] power: supply: mca: qcom_sysfs: Report stock real_type names

batterysecret reads /sys/class/qcom-battery/real_type and matches it
against the stock names (USB, USB_DCP, USB_HVDCP_3, USB_PD, PD_PPS...).
Our table reported "PD" for a PD adapter, which batterysecret treats as
Unknown, so it never ran the Xiaomi adapter verification. The adapter
stayed XM_CHARGER_TYPE_PD instead of PD_VERIFY, quick charge refused to
start and charging was capped around 20W on the buck path.

Report the stock names so the verification runs and the charge pump
path can take over with the bundled charger.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01QY97AsgNLyAwQpzrsxC9zt
---
 .../supply/mca/mca_qcom_sysfs/mca_qcom_sysfs.c     | 14 ++++++++++----
 1 file changed, 10 insertions(+), 4 deletions(-)

diff --git a/drivers/power/supply/mca/mca_qcom_sysfs/mca_qcom_sysfs.c b/drivers/power/supply/mca/mca_qcom_sysfs/mca_qcom_sysfs.c
index 74fb066..2ba4161 100644
--- a/drivers/power/supply/mca/mca_qcom_sysfs/mca_qcom_sysfs.c
+++ b/drivers/power/supply/mca/mca_qcom_sysfs/mca_qcom_sysfs.c
@@ -24,11 +24,17 @@ struct mca_qcom_sysfs_dev {
 	bool support_multi_typec;
 };
 
-/* Indexed by the adapter type returned from protocol_class_get_adapter_type(). */
+/*
+ * Indexed by the adapter type returned from protocol_class_get_adapter_type().
+ * The names follow the stock qcom-battery real_type node: batterysecret only
+ * starts the Xiaomi adapter verification when it reads "USB_PD", and an
+ * unverified adapter never leaves the buck path.
+ */
 static const char *const power_supply_usb_type_text[] = {
-	"Unknown", "SDP",	"CDP",	     "DCP", "USB_FLOAT", "HVDCP",
-	"HVDCP_3", "HVDCP_3_B", "HVDCP_3P5", "C",   "PD",	 "PD_PPS",
-	"PD_PPS",  "Unknown",	"ACA",	     "DCP",
+	"Unknown",     "USB",	      "USB_CDP",	 "USB_DCP",
+	"USB_FLOAT",   "USB_HVDCP",   "USB_HVDCP_3",	 "USB_HVDCP_3",
+	"USB_HVDCP_3", "USB_C",	      "USB_PD",		 "PD_PPS",
+	"PD_PPS",      "Unknown",     "USB_ACA",	 "USB_DCP",
 };
 
 /* Indexed by strategy_class_wireless_ops_get_wls_type() (xm_wls_charger_type). */
-- 
