+extern "C" void foo(std::atomic_bool& ready) {
+  LOG(INFO) << "foo";
+  ready = true;
+  std::this_thread::sleep_for(1000s);
+}
+
+extern "C" void bar(std::atomic_bool& ready) {
+  LOG(INFO) << "bar";
+  ready = true;
+  std::this_thread::sleep_for(1000s);
+}
