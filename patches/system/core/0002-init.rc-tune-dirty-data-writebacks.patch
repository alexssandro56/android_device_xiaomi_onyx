+#pragma once
+
+#include <stdint.h>
+#include <sys/epoll.h>
+
+#include <chrono>
+#include <functional>
+#include <map>
+#include <memory>
+#include <optional>
+#include <unordered_set>
+#include <vector>
+
+#include <android-base/unique_fd.h>
+
+#include "result.h"
+
+namespace android {
+namespace init {
+
+class Epoll {
+  public:
+    Epoll();
+
+    typedef std::function<void()> Handler;
+
+    Result<void> Open();
+    Result<void> RegisterHandler(int fd, Handler handler, uint32_t events = EPOLLIN);
+    Result<void> UnregisterHandler(int fd);
+    void SetFirstCallback(std::function<void()> first_callback);
+    Result<int> Wait(std::optional<std::chrono::milliseconds> timeout);
+
+  private:
+    struct Info {
+        Handler handler;
+        uint32_t events;
+    };
+
+    android::base::unique_fd epoll_fd_;
+    std::map<int, Info> epoll_handlers_;
+    std::function<void()> first_callback_;
+    std::unordered_set<int> to_remove_;
+};
+
+}  // namespace init
+}  // namespace android
