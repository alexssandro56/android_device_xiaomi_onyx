+cc_test_host {
+    name: "fuzzy_fastboot",
+    isolated: false,
+    compile_multilib: "first",
+
+    srcs: [
+        "main.cpp",
+        "extensions.cpp",
+        "transport_sniffer.cpp",
+        "fixtures.cpp",
+        "test_utils.cpp",
+    ],
+
+    static_libs: [
+        "libfastboot",
+        "libfastboot2",
+        "libziparchive",
+        "libsparse",
+        "libutils",
+        "liblog",
+        "libz",
+        "libdiagnose_usb",
+        "libbase",
+        "libcutils",
+        "libgtest",
+        "libgtest_main",
+        "libbase",
+        "libadb_host",
+        "libtinyxml2",
+        "libsparse",
+        "liblp",
+        "libcrypto",
+        "libext4_utils",
+    ],
+
+    stl: "libc++_static",
+
+    // Static libs (libfastboot2) shared library dependencies are not transitively included
