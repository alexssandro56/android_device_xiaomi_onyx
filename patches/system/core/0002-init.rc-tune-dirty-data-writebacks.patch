new file mode 100644
index 0000000..d5db3cb
--- /dev/null
+++ b/libutils/binder/include/utils/Vector.h
@@ -0,0 +1,418 @@
+/*
+ * Copyright (C) 2005 The Android Open Source Project
+ *
