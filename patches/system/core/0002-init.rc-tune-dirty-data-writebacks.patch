+
+#include <fcntl.h>
+#include <unistd.h>
+
+int toggle_O_NONBLOCK(int fd) {
+    int flags = fcntl(fd, F_GETFL);
+    if (flags == -1 || fcntl(fd, F_SETFL, flags ^ O_NONBLOCK) == -1) {
+        close(fd);
+        return -1;
+    }
+    return fd;
+}
