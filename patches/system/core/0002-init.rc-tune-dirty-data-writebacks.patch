+static Result<void> DoLoadApex(const std::string& apex_name) {
+    if (auto result = ParseRcScriptsFromApex(apex_name); !result.ok()) {
+        return result.error();
+    }
+
+    if (auto result = UpdateApexLinkerConfig(apex_name); !result.ok()) {
+        return result.error();
+    }
+
+    return {};
+}
