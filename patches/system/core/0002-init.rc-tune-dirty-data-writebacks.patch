+        "android.hardware.boot-V1-ndk",
+        "libboot_control_client",
+        "android.hardware.fastboot@1.1",
+        "android.hardware.fastboot-V1-ndk",
+        "android.hardware.health@2.0",
+        "android.hardware.health-V5-ndk",
+        "libasyncio",
+        "libbase",
+        "libbinder_ndk",
+        "libbootloader_message",
+        "libcutils",
+        "libext2_uuid",
