+namespace {
+
+inline size_t history_size(
+    const std::map<uint64_t, struct uid_records>& history)
+{
+    size_t count = 0;
+    for (auto const& it : history) {
+        count += it.second.entries.size();
+    }
+    return count;
+}
+
