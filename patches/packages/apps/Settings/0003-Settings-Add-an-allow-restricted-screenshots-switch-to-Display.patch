 res/values/onyx_strings.xml                   |  2 +
 res/xml/display_settings.xml                  |  6 +++
 ...ableSecureWindowsPreferenceController.java | 45 +++++++++++++++++++
 4 files changed, 55 insertions(+)
 create mode 100644 src/com/android/settings/display/DisableSecureWindowsPreferenceController.java

