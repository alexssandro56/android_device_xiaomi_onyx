     <string name="network_traffic_hidearrow_title">Ocultar setas</string>
     <string name="network_traffic_hidearrow_summary">Ocultar as setas de subida/descida</string>
+    <string name="disable_secure_windows_title">Permitir captura de conteúdo restrito</string>
