diff --git a/src/com/android/settings/display/DisableSecureWindowsPreferenceController.java b/src/com/android/settings/display/DisableSecureWindowsPreferenceController.java
new file mode 100644
index 0000000..0167504
--- /dev/null
+++ b/src/com/android/settings/display/DisableSecureWindowsPreferenceController.java
@@ -0,0 +1,40 @@
+/*
+ * SPDX-FileCopyrightText: 2026 alexssandro56
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.display;
+
+import android.content.Context;
+import android.provider.Settings;
+
+import com.android.settings.R;
+import com.android.settings.core.TogglePreferenceController;
+
+public class DisableSecureWindowsPreferenceController extends TogglePreferenceController {
+
+    public DisableSecureWindowsPreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public boolean isChecked() {
+        return Settings.Secure.getInt(mContext.getContentResolver(), getPreferenceKey(), 0) != 0;
+    }
+
+    @Override
+    public boolean setChecked(boolean isChecked) {
+        return Settings.Secure.putInt(mContext.getContentResolver(), getPreferenceKey(),
+                isChecked ? 1 : 0);
+    }
+
+    @Override
+    public int getSliceHighlightMenuRes() {
+        return R.string.menu_key_display;
+    }
+}
diff --git a/src/com/android/settings/display/GameSpoofDevicePreferenceController.java b/src/com/android/settings/display/GameSpoofDevicePreferenceController.java
new file mode 100644
index 0000000..d771af1
--- /dev/null
+++ b/src/com/android/settings/display/GameSpoofDevicePreferenceController.java
@@ -0,0 +1,66 @@
+/*
+ * SPDX-FileCopyrightText: 2026 alexssandro56
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.display;
+
+import android.content.Context;
+import android.provider.Settings;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+
+import com.android.settings.R;
+import com.android.settings.core.BasePreferenceController;
+
+public class GameSpoofDevicePreferenceController extends BasePreferenceController
+        implements Preference.OnPreferenceChangeListener {
+
+    public GameSpoofDevicePreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public void displayPreference(PreferenceScreen screen) {
+        super.displayPreference(screen);
+        final ListPreference pref = screen.findPreference(getPreferenceKey());
+        if (pref != null) {
+            pref.setOnPreferenceChangeListener(this);
+        }
+    }
+
+    private String getValue() {
+        final String v = Settings.System.getString(mContext.getContentResolver(),
+                getPreferenceKey());
+        return v == null ? "off" : v;
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        final ListPreference pref = (ListPreference) preference;
+        pref.setValue(getValue());
+        pref.setSummary(pref.getEntry());
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        Settings.System.putString(mContext.getContentResolver(), getPreferenceKey(),
+                (String) newValue);
+        final ListPreference pref = (ListPreference) preference;
+        pref.setValue((String) newValue);
+        pref.setSummary(pref.getEntry());
+        return true;
+    }
+
+    @Override
+    public int getSliceHighlightMenuRes() {
+        return R.string.menu_key_display;
+    }
+}
