From 9b6697cbaccc2b1ad7ffc7e6bb7ecdbf575f517c Mon Sep 17 00:00:00 2001
From: onyx <onyx@localhost>
Date: Sun, 8 Nov 2026 12:47:53 +0000
Subject: [PATCH] Settings: Drop the broken co.aospa refresh_rate preference

The calcite HEAD's display_settings.xml references
co.aospa.settings.display.RefreshRateSettings / RefreshRatePreferenceController
and the strings keywords_refresh_rate / refresh_rate_title, none of which exist
in the public tree (a stale CLO merge), so aapt2 link fails. Drop the whole
preference entry; the peak/smooth-display refresh control is unaffected.

diff --git a/res/xml/display_settings.xml b/res/xml/display_settings.xml
index 29a49be..4301444 100644
--- a/res/xml/display_settings.xml
+++ b/res/xml/display_settings.xml
@@ -197,13 +197,6 @@
             android:summary="@string/display_white_balance_summary"
             settings:controller="com.android.settings.display.DisplayWhiteBalancePreferenceController"/>
 
-        <Preference
-            android:key="refresh_rate"
-            android:title="@string/refresh_rate_title"
-            android:summary="@string/summary_placeholder"
-            android:fragment="co.aospa.settings.display.RefreshRateSettings"
-            settings:keywords="@string/keywords_refresh_rate"
-            settings:controller="co.aospa.settings.display.RefreshRatePreferenceController"/>
 
         <SwitchPreferenceCompat
             android:key="show_operator_name"
-- 
2.43.0

