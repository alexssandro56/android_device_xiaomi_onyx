diff --git a/src/com/android/settings/display/DisableSecureWindowsPreferenceController.java b/src/com/android/settings/display/DisableSecureWindowsPreferenceController.java
new file mode 100644
index 0000000..6bc02c8
--- /dev/null
+++ b/src/com/android/settings/display/DisableSecureWindowsPreferenceController.java
@@ -0,0 +1,45 @@
+/*
+ * SPDX-FileCopyrightText: 2026 alexssandro56
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.display;
+
+import android.content.Context;
+import android.provider.Settings;
+
+import com.android.settings.R;
+import com.android.settings.core.TogglePreferenceController;
+
+/**
+ * Switch for Settings.Secure.disable_secure_windows, which WindowManager reads to drop
+ * FLAG_SECURE from windows so restricted content can be captured. WindowManager only
+ * honours it on debuggable builds, but the switch is harmless either way.
+ */
+public class DisableSecureWindowsPreferenceController extends TogglePreferenceController {
+
+    public DisableSecureWindowsPreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public boolean isChecked() {
+        return Settings.Secure.getInt(mContext.getContentResolver(), getPreferenceKey(), 0) != 0;
+    }
+
+    @Override
+    public boolean setChecked(boolean isChecked) {
+        return Settings.Secure.putInt(mContext.getContentResolver(), getPreferenceKey(),
+                isChecked ? 1 : 0);
+    }
+
+    @Override
+    public int getSliceHighlightMenuRes() {
+        return R.string.menu_key_display;
+    }
+}
-- 
