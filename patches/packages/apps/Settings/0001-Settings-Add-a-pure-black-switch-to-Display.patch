 res/values/onyx_strings.xml                   | 10 +++++
 res/xml/display_settings.xml                  |  6 +++
 .../PureBlackThemePreferenceController.java   | 42 +++++++++++++++++++
 4 files changed, 67 insertions(+)
 create mode 100644 res/values-pt-rBR/onyx_strings.xml
 create mode 100644 res/values/onyx_strings.xml
 create mode 100644 src/com/android/settings/display/PureBlackThemePreferenceController.java

diff --git a/res/values-pt-rBR/onyx_strings.xml b/res/values-pt-rBR/onyx_strings.xml
new file mode 100644
