+</resources>
diff --git a/res/values/onyx_strings.xml b/res/values/onyx_strings.xml
new file mode 100644
index 0000000..1ec7413
--- /dev/null
+++ b/res/values/onyx_strings.xml
@@ -0,0 +1,10 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     SPDX-FileCopyrightText: 2026 alexssandro56
+     SPDX-License-Identifier: Apache-2.0
+-->
+<resources>
+    <!-- Display settings: pure black dark theme -->
+    <string name="pure_black_theme_title">Pure black</string>
