--- /dev/null
+++ b/res/values-pt-rBR/onyx_strings.xml
@@ -0,0 +1,9 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     SPDX-FileCopyrightText: 2026 alexssandro56
