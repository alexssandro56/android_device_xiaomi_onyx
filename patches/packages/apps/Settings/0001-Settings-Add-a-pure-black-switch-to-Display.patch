diff --git a/res/xml/display_settings.xml b/res/xml/display_settings.xml
index 29a49be..dc749f8 100644
--- a/res/xml/display_settings.xml
+++ b/res/xml/display_settings.xml
@@ -107,6 +107,12 @@
             settings:controller="com.android.settings.display.DarkUIPreferenceController"
             settings:keywords="@string/keywords_dark_ui_mode"/>
 
+        <SwitchPreferenceCompat
+            android:key="pure_black_theme"
+            android:title="@string/pure_black_theme_title"
+            android:summary="@string/pure_black_theme_summary"
+            settings:controller="com.android.settings.display.PureBlackThemePreferenceController"/>
+
         <Preference
             android:fragment="com.android.settings.accessibility.TextReadingPreferenceFragment"
             android:key="text_reading_options"
diff --git a/src/com/android/settings/display/PureBlackThemePreferenceController.java b/src/com/android/settings/display/PureBlackThemePreferenceController.java
new file mode 100644
index 0000000..e1c4494
--- /dev/null
+++ b/src/com/android/settings/display/PureBlackThemePreferenceController.java
@@ -0,0 +1,42 @@
+/*
+ * SPDX-FileCopyrightText: 2026 alexssandro56
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.display;
+
+import android.content.Context;
+import android.provider.Settings;
+
+import com.android.settings.R;
+import com.android.settings.core.TogglePreferenceController;
+
+/** Switches the dark theme between the dynamic color surfaces and pure black. */
+public class PureBlackThemePreferenceController extends TogglePreferenceController {
+
+    public PureBlackThemePreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public boolean isChecked() {
+        return Settings.Secure.getInt(mContext.getContentResolver(),
+                Settings.Secure.PURE_BLACK_THEME, 0) != 0;
+    }
+
+    @Override
+    public boolean setChecked(boolean isChecked) {
+        return Settings.Secure.putInt(mContext.getContentResolver(),
+                Settings.Secure.PURE_BLACK_THEME, isChecked ? 1 : 0);
+    }
+
+    @Override
+    public int getSliceHighlightMenuRes() {
+        return R.string.menu_key_display;
+    }
+}
