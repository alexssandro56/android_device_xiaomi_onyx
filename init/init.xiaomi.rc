on post-fs-data
    # Fingerprint
    mkdir /data/vendor/misc 01771 system system
    mkdir /data/vendor/misc/mi_fp 0770 system system
    mkdir /persist/mi_fp 0770 system system
    mkdir /mnt/vendor/persist/mi_fp 0770 system system
    mkdir /data/vendor/fpc 0770 system system
    mkdir /data/vendor/fpdump 0770 system system
    mkdir /data/vendor/goodix 0770 system system
    mkdir /data/vendor/fpdata 0770 system system
    mkdir /data/vendor/fingerprint 0770 system system
    mkdir /mnt/vendor/persist/goodix 0770 system system
    mkdir /mnt/vendor/persist/fingerprint 0770 system system
    mkdir /data/vendor/fpdump/qfs4008 0770 system system
    mkdir /mnt/vendor/persist/fingerprint/meta 0770 system system
    mkdir /mnt/vendor/persist/fingerprint/jiiov 0770 system system

    #Create folder of camera
    mkdir /data/vendor/camera 0777 camera camera
    mkdir /data/vendor/camera/offlinelog 0777 cameraserver audio
    mkdir /data/vendor/camera/aftersalelog 0777 cameraserver audio
    mkdir /data/vendor/camera/overlay 0777 cameraserver audio
    # MIUI ADD: Camera_CameraSkyNet
    chmod 0666 /dev/camlog
    #END Camera_CameraSkyNet

    # MIUI ADD: Camera_CamSched
    chmod 0666 /dev/mi_cam_sched
    # END Camera_CamSched

    # Create directory for modem
    mkdir /data/vendor/modem 0777 root root
    mkdir /data/vendor/modem/diag_logs 0777 root root

    #Create folder of memory
    mkdir /data/vendor/memory 0777 system system
    mkdir /data/vendor/memory/error_history 0777 system system

    # Create directory used by video subsystem
    mkdir /data/vendor/video 0777 audio audio
    write /data/vendor/video/videohalPid 0
    chown audio audio /data/vendor/video/videohalPid
    chmod 0777 /data/vendor/video/videohalPid
    write /data/vendor/video/vppservicePid 0
    chown audio audio /data/vendor/video/vppservicePid
    chmod 0777 /data/vendor/video/vppservicePid

    # Create the directory used by qrtr-lookup
    mkdir /data/vendor/qrtr 0775 system system

on early-boot
    # Fingerprint
    chown system graphics /sys/bus/platform/devices/soc:xiaomi_fingerprint/fingerdown
    chmod 0664 /sys/bus/platform/devices/soc:xiaomi_fingerprint/fingerdown

    # WLAN: boot WPSS, as the stock init.vendor.wlan.rc does. Without this
    # the WCN7750 firmware never comes up and writing ON to /dev/wlan times out.
    write /sys/kernel/icnss/wlan_en_delay 1000
    write /sys/kernel/icnss/wpss_boot 1

on boot
    # Fingerprint
    chmod 0666 /dev/xiaomi-fp
    chown system system /dev/xiaomi-fp
    chmod 0666 /dev/mifp_id
    chown system system /dev/mifp_id
    chmod 0666 /dev/input/event2
    chown system system /sys/bus/platform/devices/soc:xiaomi_fingerprint/intr2
    chmod 0666 /sys/bus/platform/devices/soc:xiaomi_fingerprint/intr2

#for online boot cpu
on property:sys.boot_completed=1
    wait /sys/class/thermal/thermal_message/boot_complete
    write /sys/class/thermal/thermal_message/boot_complete 2

    # Run mi_thermald in mgame mode. Out of all the modes that run the CPU at
    # advertised speeds without underclocking, it has the most conservative
    # thermal limits. The default mode caps the big cores below their maximum
    # from 25°C. Keep in sync with ChargingThermalController.
    write /sys/devices/virtual/thermal/thermal_message/sconfig 19
    write /dev/kmsg "start qrtr-lookup after Boot completed "
    start qrtr-lookup

service vendor.sensors-hal-multihal /vendor/bin/hw/android.hardware.sensors-service.xiaomi-multihal
    override
    class hal
    user system
    group system wakelock context_hub input uhid
    task_profiles ServiceCapacityLow
    socket audio_us_socket_1 seqpacket 0666 system system
    capabilities BLOCK_SUSPEND
    rlimit rtprio 10 10

service vendor.audio-hal-aidl /vendor/bin/hw/audiohalservice.qti
    override
    class hal
    user audioserver
    group audio media mediadrm drmrpc inet net_bt net_bt_admin net_bw_acct wakelock context_hub oem_2901 oem_2912 system
    capabilities BLOCK_SUSPEND SYS_NICE
    # setting RLIMIT_RTPRIO allows binder RT priority inheritance
    rlimit rtprio 10 10
    ioprio rt 4
    task_profiles ProcessCapacityHigh HighPerformance
    writepid /dev/cpuset/foreground/tasks /dev/stune/foreground/tasks
    socket audio_holder_socket_0 seqpacket 0666 system system
    socket audio_agm_socket_0 seqpacket 0666 system system
    socket audio_us_socket_0 seqpacket 0666 system system
    onrestart restart audioserver

service qrtr-lookup /vendor/bin/qrtr-lookup
    class core
    user system
    group system
    disabled
    oneshot

# ABL only enters off-mode charging when power_off_mode in the charger partition is 1,
# and the MCA driver resets it on every boot. Set it on shutdown like MiuiBatteryServiceImpl.
on property:sys.shutdown.requested=0userrequested
    write /sys/class/xm_power/charger/charger_partition/charger_partition_poweroffmode 1

on property:sys.shutdown.requested=0thermal,battery
    write /sys/class/xm_power/charger/charger_partition/charger_partition_poweroffmode 1

# Charging control node used by vendor.lineage.health
on boot
    chown system system /sys/class/xm_power/charger/smart_charge/smart_night
    chmod 0660 /sys/class/xm_power/charger/smart_charge/smart_night

# init.qti.kernel.sh starts msm_irqbalance whenever the binary exists. Stock
# doesn't ship it on sun and it exits right away, so don't restart it forever.
service vendor.msm_irqbalance /vendor/bin/msm_irqbalance -f /system/vendor/etc/msm_irqbalance.conf
    override
    class core
    user root
    group root
    disabled
    oneshot

# The odm touchfeature rc runs /odm/etc/tp_kmsg_init.sh, a touch debug log
# script that isn't in the proprietary files. vendor rc files are parsed
# first, so this definition replaces it.
service touch-kmsg-init-sh /system/vendor/bin/sh /odm/etc/tp_kmsg_init.sh
    class main
    group root system
    disabled
    oneshot
