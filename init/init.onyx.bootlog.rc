# Bring-up only: save the kernel log and logcat of every boot to /metadata,
# which is mounted in first stage and survives a reboot, so a boot that
# hangs or reboots can be read back from recovery.

on post-fs
    mkdir /metadata/bootlog 0777 root root
    start onyx_bootlog_dmesg
    start onyx_bootlog_logcat

service onyx_bootlog_dmesg /system/bin/sh -c "cd /metadata/bootlog && mv -f dmesg.txt dmesg.prev.txt; /system/bin/dmesg -w > dmesg.txt"
    user root
    group root
    seclabel u:r:su:s0
    disabled
    oneshot

service onyx_bootlog_logcat /system/bin/sh -c "cd /metadata/bootlog && mv -f logcat.txt logcat.prev.txt; while true; do /system/bin/logcat -b all -v threadtime >> logcat.txt; sleep 1; done"
    user root
    group root
    seclabel u:r:su:s0
    disabled
    oneshot
