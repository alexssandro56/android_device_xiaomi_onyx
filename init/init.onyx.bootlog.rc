# Bring-up only: save the kernel log and logcat of every boot to /metadata,
# which is mounted in first stage and survives a reboot, so a boot that
# hangs or reboots can be read back from recovery.

on post-fs
    mkdir /metadata/bootlog 0777 root root
    rm /metadata/bootlog/dmesg.prev.txt
    rm /metadata/bootlog/logcat.prev.txt
    rename /metadata/bootlog/dmesg.txt /metadata/bootlog/dmesg.prev.txt
    rename /metadata/bootlog/logcat.txt /metadata/bootlog/logcat.prev.txt
    start onyx_bootlog_dmesg
    start onyx_bootlog_logcat

service onyx_bootlog_dmesg /system/bin/sh -c "/system/bin/dmesg -w > /metadata/bootlog/dmesg.txt"
    user root
    group root
    seclabel u:r:su:s0
    disabled
    oneshot

service onyx_bootlog_logcat /system/bin/sh -c "while true; do /system/bin/logcat -b all -v threadtime >> /metadata/bootlog/logcat.txt; sleep 1; done"
    user root
    group root
    seclabel u:r:su:s0
    disabled
    oneshot
