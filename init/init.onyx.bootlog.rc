# Debugging only: save the kernel log and logcat of every boot to /metadata,
# which survives a reboot, so a boot that hangs or reboots can be read back
# from recovery. The logcat keeps running for as long as the phone is on,
# which costs battery, so it only starts after
#   setprop persist.sys.onyx.bootlog 1
# and a reboot.

on property:persist.sys.onyx.bootlog=1
    mkdir /metadata/bootlog 0777 root root
    start onyx_bootlog_dmesg
    start onyx_bootlog_logcat

service onyx_bootlog_dmesg /system/bin/sh -c "cd /metadata/bootlog && mv -f dmesg.txt dmesg.prev.txt; /system/bin/dmesg -w > dmesg.txt"
    user root
    group root
    seclabel u:r:su:s0
    disabled
    oneshot

service onyx_bootlog_logcat /system/bin/sh -c "cd /metadata/bootlog && mv -f logcat.txt logcat.prev.txt; while true; do /system/bin/logcat -b all -v threadtime >> logcat.txt; sleep 1; done"
    user root
    group root
    seclabel u:r:su:s0
    disabled
    oneshot

# Off-mode charging never reaches post-fs. Keep its logs in separate files,
# so booting to Android afterwards doesn't rotate them away.
on charger
    mkdir /metadata/bootlog 0777 root root
    start onyx_chglog_dmesg
    start onyx_chglog_logcat

service onyx_chglog_dmesg /system/bin/sh -c "cd /metadata/bootlog && /system/bin/dmesg -w > charger_dmesg.txt"
    user root
    group root
    seclabel u:r:su:s0
    disabled
    oneshot

service onyx_chglog_logcat /system/bin/sh -c "cd /metadata/bootlog && while true; do /system/bin/logcat -b all -v threadtime >> charger_logcat.txt; sleep 1; done"
    user root
    group root
    seclabel u:r:su:s0
    disabled
    oneshot
