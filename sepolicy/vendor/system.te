binder_call(system_server, hal_touchfeature_xiaomi_default)

allow system_server hal_touchfeature_xiaomi_default:process signal;

# SnapdragonServices (system_server access is neverallowed by QCOM)
dontaudit system_server vendor_hal_snapx_service:service_manager find;
dontaudit system_server vendor_hal_snapx_default:binder call;

# Battery stats (charge_full, cycle_count, current_now...) for PowerInsightService
r_dir_file(system_server, vendor_sysfs_battery_supply)
