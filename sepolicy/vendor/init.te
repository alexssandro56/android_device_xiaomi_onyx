set_prop(vendor_init, vendor_camera_prop)
set_prop(vendor_init, vendor_deviceid_prop)
set_prop(vendor_init, vendor_displayfeature_prop)
set_prop(vendor_init, vendor_mischeck_prop)
set_prop(vendor_init, vendor_qcc_prop)
set_prop(vendor_init, vendor_radio_prop)
set_prop(vendor_init, vendor_ssr_prop)
set_prop(vendor_init, vendor_thermal_normal_prop)
set_prop(vendor_init, vendor_touchfeature_prop)

allow vendor_init minidump_data_file:dir create_dir_perms;
allow vendor_init minidump_data_file:file create_file_perms;
allow vendor_init migt_dev:chr_file getattr;

allow init sysfs_reserve_pool:dir search;
allow init sysfs_reserve_pool:file w_file_perms;

allow vendor_init migt_dev:chr_file setattr;

dontaudit vendor_init { cache_file media_rw_data_file }:dir r_dir_perms;
dontaudit vendor_init media_rw_data_file:file getattr;
dontaudit vendor_init radio_prop:file read;
dontaudit vendor_init sysfs:lnk_file setattr;

allow vendor_init proc_walt:dir search;
allow vendor_init proc_walt:file w_file_perms;
allow vendor_init vendor_miev_device:chr_file { getattr setattr };

# init.qcom.rc turns UFS clock scaling off during boot and back on after
allow vendor_init vendor_sysfs_ufs:file w_file_perms;
