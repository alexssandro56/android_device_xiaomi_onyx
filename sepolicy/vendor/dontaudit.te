dontaudit untrusted_app ashmem_device:chr_file open;

dontaudit {
  hal_camera_default
} default_prop:file r_file_perms;

# Perf/QSPM lookups from framework code (BoostFramework) in app processes
dontaudit appdomain {
  vendor_hal_perf2_service
  vendor_hal_qspmhal_service
}:service_manager find;
dontaudit priv_app {
  vendor_hal_perf_default
  vendor_hal_qspmhal_default
}:binder call;
dontaudit priv_app device:dir open;

# Partitions without a block label that fs_mgr checks before mounting
dontaudit fsck block_device:blk_file rw_file_perms;
dontaudit fsck sysfs:file r_file_perms;
dontaudit { kernel vendor_modprobe } block_device:dir search;
dontaudit vold { mnt_product_file vendor_qmcs_file vendor_spunvm_file }:dir { ioctl r_dir_perms };

# Framework code in app processes probes display feature props
dontaudit appdomain vendor_displayfeature_prop:file r_file_perms;
dontaudit { bootanim surfaceflinger system_server } vendor_displayfeature_prop:file r_file_perms;

# Optional lookups and probes that work without the access
dontaudit platform_app default_android_service:service_manager find;
dontaudit system_server vendor_default_prop:file r_file_perms;
# CachedAppOptimizer freezes binder on every binder device, vndbinder included
dontaudit system_server vndbinder_device:chr_file write;
dontaudit hal_camera_default system_data_file:dir search;
dontaudit init debugfs_tracing_debug:dir mounton;
dontaudit kernel self:capability net_bind_service;
dontaudit gpuservice fs_bpf:file getattr;
dontaudit untrusted_app_all { mnt_vendor_file mnt_product_file vm_data_file }:dir { getattr search };
dontaudit untrusted_app_all vendor_sysfs_kgsl:file r_file_perms;
dontaudit vendor_qrtr vendor_data_file:dir write;
dontaudit vendor_diag-router vendor_data_file:dir write;
