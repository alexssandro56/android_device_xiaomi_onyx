# Open-source Xiaomi thermal daemon (IRedDragonICY/mithermald).
# Reads the active profile from persist.sys.mithermal.ss_profile and applies
# per-profile CPU/GPU/charging limits by writing sysfs.
type mi_thermal_engine, domain;
type mi_thermal_engine_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(mi_thermal_engine)

# Profile and tuning IPC with Pentas: persist.sys.mithermal.* (mithermal_prop
# is declared by Pentas's public sepolicy).
get_prop(mi_thermal_engine, mithermal_prop)

# Bring-up: run permissive on userdebug/eng so the daemon can apply thermal
# control while we collect the exact AVC denials from the audit log. Once the
# log is clean, replace this with explicit allow rules. Not applied on user
# builds, so this never ships permissive to a release.
userdebug_or_eng(`
  permissive mi_thermal_engine;
')
