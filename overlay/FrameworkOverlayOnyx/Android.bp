    name: "FrameworkOverlayOnyxCN",
    manifest: "AndroidManifest-CN.xml",
    resource_dirs: ["res-CN"],
    device_specific: true,
}

runtime_resource_overlay {
    name: "FrameworkOverlayOnyxGL",
    manifest: "AndroidManifest-GL.xml",
    resource_dirs: ["res-GL"],
    device_specific: true,
}
